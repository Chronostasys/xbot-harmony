{
  "app": {
    // ⚠️ `signingConfigs` 里有 `default`（本机 DevEco 自动签名产物）**且 products[0] 必须引用它**
    //    （`"signingConfig": "default"`），否则 hvigor 报 `No signingConfig found for product default`
    //    ⇒ 产出 *-unsigned.hap ⇒ 装机必报 `install sign info inconsistent`（9568332）。
    //    CI 里请覆盖本块（带本机绝对路径的配置在 CI 必然失败），见 docs/CI.md。
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/Users/bobli/.ohos/config/default_xbot-harmony_mY232WjY-IQHMDmsbe9aCw25X4ZjM1Ijj-DDZ6rn2cQ=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001B5EC2E2AADF36A33CD6E22EF69AB1AC7DA9EC6895FE21D37685E482C25BD4729F8EB4B21D4B295F",
          "profile": "/Users/bobli/.ohos/config/default_xbot-harmony_mY232WjY-IQHMDmsbe9aCw25X4ZjM1Ijj-DDZ6rn2cQ=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/Users/bobli/.ohos/config/default_xbot-harmony_mY232WjY-IQHMDmsbe9aCw25X4ZjM1Ijj-DDZ6rn2cQ=.p12",
          "storePassword": "0000001B33DE75B91EE44C9B98E01FC3D2A9A2A649C54BFDBCC0623E56CF9ECBE333DC9042CBD29B1F13AD"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        // ⚠️ API 26 工程必须写 "26.0.0"（不能写 26.0.0(26) / 26），见 docs/CI.md
        // 2026-10-10 抬高：为引入 `@hxa-atpc/noties_prism4j`（语法高亮分词器，要求 ≥21）。
        // ⛔ 这会把最低支持从 HarmonyOS 5.0 抬到 6.0 —— 是**产品级取舍**，已与需求方确认
        //    （其设备为 HarmonyOS 7.0）。若要恢复 5.x 支持，需回退到 5.0.0(12) 并放弃该依赖。
        "compatibleSdkVersion": "6.0.1(21)",
        "targetSdkVersion": "6.0.1(21)",
        "signingConfig": "default",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            // 2026-10-10 改 true：bytecode HAR（`@hxa-atpc/noties_prism4j`）**要求**
            // `useNormalizedOHMUrl: true`，否则构建报 00306046（见 errorcode-00306）。
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
